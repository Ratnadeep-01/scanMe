# ==============================================================================
# ReviewFlow Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Database Connection (Admin Console & Persistent Data)
# ------------------------------------------------------------------------------
# Option A: MongoDB Atlas Cloud (Free tier at https://www.mongodb.com/cloud/atlas)
# Replace <username>, <password>, and cluster address:
# MONGODB_URI=mongodb+srv://admin_user:YourStrongPassword@cluster0.abcde.mongodb.net/reviewboost?retryWrites=true&w=majority
#
# Option B: Local MongoDB (Docker or MongoDB Community Server):
# MONGODB_URI=mongodb://127.0.0.1:27017/reviewboost
MONGODB_URI=
MONGODB_DB=reviewboost

# ------------------------------------------------------------------------------
# 2. OpenAI API Key (Optional)
# ------------------------------------------------------------------------------
# If left blank, ReviewFlow uses its built-in anti-robotic generative fallback engine.
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Admin Console Access Passkey (Restricts Customer Access)
# ------------------------------------------------------------------------------
# Passkey required to access /admin operations console.
# Default if left blank: admin123
ADMIN_PASSWORD=admin123

